# 공공데이터포털 일반 인증키 (실거래가 매매/전월세, K-apt 단지목록/기본/상세, 건축물대장 - API별 활용신청 필요)
DATA_GO_KR_KEY=
# VWorld 오픈API 인증키 (서비스 URL에 배포 도메인 등록 필요)
VWORLD_API_KEY=
# (선택) VWorld 키에 등록한 도메인 - 서버에서 지오코더 호출 시 전달
VWORLD_DOMAIN=
# 카카오 디벨로퍼스 REST API 키 (로컬 API: 주변 시설 검색)
KAKAO_REST_API_KEY=
# (급등·급락 일일 계산용) GitHub Actions가 Vercel 서울 리전 프록시로 실거래를 받을 때 쓰는 비밀값 - Vercel과 GitHub Secrets에 같은 값
HOT_BUILD_SECRET=
